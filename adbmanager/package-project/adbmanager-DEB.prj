[NAME]
name=adbmanager

[VERSION]
version=4.1

[RELEASE]
release=0.mrx10

[GROUP]
group=Applications/System

[DESCRIPTION]
0=The program is designed for visual and easy management of the ADB and connection of Android devices
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=Manager for Android devices using ADB

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/adbmanager

[LICENSE]
license=GPLv3

[DEPS]
deps=adb iproute2 nmap 7zip graphicsmagick xdg-utils libgtk2.0-0 libqt6core6 libqt6gui6 libqt6widgets6 libqt6printsupport6 libqt6pas6

[META]
meta=0

[NOARCH]
noarch=0

[DEB]
deb=1

[FILES]
0=/usr/bin/adbmanager
1=/usr/share/icons/adbmanager.png
2=/usr/share/applications/adbmanager.desktop
3=/usr/share/adbmanager/
4=/usr/share/doc/adbmanager/
5=/usr/bin/adbmanager-qt
6=/usr/share/icons/adbmanager-qt.png
7=/usr/share/applications/adbmanager-qt.desktop
8=/usr/bin/adbmanager-shell
9=/usr/share/applications/adbmanager-shell.desktop

[AFTERINSTALL]
0=[ $(grep "adbusers" /etc/group) ] || groupadd adbusers

[URL32]
url32=https://github.com/AKotov-dev/adbmanager

[PROGRAMNAME]
programname=ADBManager

[DEVTOOL]
devtool=Lazarus

[TOOLVERSION]
toolversion=4.4

[INFO]
0=The program is designed for visual and easy management of the ADB and connection
1=of Android smartphones. Allows you to monitor the status of the "adb" service,
2=manage it, and control the list of connected devices.
3=
4=v4.1
5=+ Package installation / update: added the `-r` option
6=+ Replaced Sakura with the system default terminal emulator
7=+ Android TV Box Settings: added a **Clear Download Manager data** button
8=+ Added packages for **Mageia 10**, **Fedora 44** and **Ubuntu ≥ 25.04**
9=
10=**Maintainer note**
11=Sakura is no longer required; ADB Manager uses the system default terminal.
12=The helper script and desktop entry are installed as:
13=```
14=/usr/bin/adbmanager-shell
15=/usr/share/applications/adbmanager-shell.desktop
16=```
17=
18=v4.0
19=+ Build in Lazarus-4.4
20=+ SDManager: Waiting process indicator
21=+ AppManager: Support for Android 4.2+
22=+ Moving app search and removal to AppManager
23=+ Mageia-9 and Ubuntu >= 25.04 packages
24=
25=v3.9
26=+ Improved inter-thread synchronization
27=+ Improved scaling/saving of form settings
28=+ Handling xdg-open errors on broken files
29=+ Android TV Box: CPU temperature indicator (°C)
30=+ Mageia-9 and Ubuntu >= 25.04 packages
31=
32=v3.8
33=+ Added `ADBManager-Qt` version (Qt6 widgets)
34=+ RPM dependencies: added `qtbase6-common`, `qt6pas`
35=+ DEB dependencies: added `libqt6core6`, `libqt6gui6`, `libqt6widgets6`, `libqt6network6`, `libqt6printsupport6`, `libqt6pas6`
36=+ Added a RAM device indicator: Total / Available (%)
37=+ Improved overall multithreading and responsiveness
38=+ Improved switching of devices in offline status (TCP/IP)
39=+ Improved the procedure for stopping package installations
40=+ Mageia-9 and Ubuntu >= 25.04 packages
41=
42=**Note:** Build for maintainers: `lazbuild --build-mode=Release adbmanager.lpi` and `lazbuild --build-mode=Qt6 adbmanager.lpi`. Build in Lazarus in two modes: `Release` and `Qt6`. For Mageia 9, a backport from Mageia 10 has been published here: lib64qt6pas6 and lib64qt6pas-devel.
43=
44=v3.7
45=+ Dependencies RPM/DEB: added `xdg-utils`
46=+ Dependencies RPM/DEB: replace `imagemagick` with `graphicsmagick`
47=+ Improved application list output stream
48=+ Improved SDCard manager for different DPI (text alignment)
49=+ Improved package search in the application manager (multiselect)
50=+ Double-clicking in the SDCard manager opens files using xdg-open
51=+ Mageia-9 and Debian packages
52=
53=v3.6
54=+ Icons in the app list if `IconExtractor.akp` is installed on the smartphone
55=+ Added RPM/DEB dependency: `imagemagick`
56=+ Mageia-9 and Debian packages
57=
58=**Note:** To display original icons in the application list, please install the [IconExtractor.apk](https://github.com/AKotov-dev/adbmanager/tree/main/IconExtractor) package on your smartphone. Installation of the package is optional.
59=
60=v3.5
61=+ Build in Lazarus-4.2
62=+ Devision by Zero bug fixed
63=+ Auto-scaling of SD card manager panels
64=+ Mageia-9 and Debian packages
65=
66=Recommended to delete the configuration directory: rm -rf ~/.adbmanager
67=
68=v3.4
69=+ Fine-tuning for Android TV Box
70=+ Mageia-9 and Debian packages + AppImage
71=
72=**Note:** Chinese Android TV Boxes often have stripped-down launchers installed, in which it is impossible to adjust the volume with the remote control, automatic updates and synchronization of Google accounts are not disabled, and there is even no control over system sounds (remote control clicks, etc.). In addition, excessive interface animation with a small amount of memory reduces the overall performance of the device. Now all this can be configured via ADB.
73=
74=v3.3
75=+ Added dependency `p7zip`
76=+ Cancel bulk package installation with `Esc`
77=+ Request to cancel package installation on exit
78=+ Improved procedure for canceling file copying
79=+ Multi installation of packages APK, APKS, XAPK
80=+ Mageia-9 and Debian packages + AppImage
81=
82=**Note:** Installation of `XAPK`packages with a single package architecture (32 bits or 64 bits) is supported. The presence of packages of both architectures (32 bits + 64 bits) in `XAPK` is not supported.
83=
84=v3.2
85=+ Recompiling to Lazarus-3.8
86=+ SD_Card Manager: Show Hidden Files
87=
88=**Note:** Be careful when working with hidden files. Do not delete or overwrite them unless necessary.
89=
90=v3.1
91=+ Exception of adb backup and restore; [Obsolete/Deprecated](https://issuetracker.google.com/issues/37096097)
92=+ Mageia-8/9 and Debian packages
93=
94=Note: Uninstalled apps are installed from Google Play [Barmalei » 17 feb 2023, 10:38](https://forum.rosalinux.ru/viewtopic.php?f=58&p=112751#p112751)
95=
96=v3.0
97=+ Deleting cache/data when uninstalling a system application
98=+ Mageia-8/9 and Debian packages
99=
100=v2.9
101=+ Removing non-removable applications (Android >= 6)
102=+ Mageia-8/9 and Debian packages
103=
104=v2.8
105=+ Enabling/Disabling applications
106=+ Mageia-8/9 and Debian packages
107=+ Recompilation in Lazarus 2.2.4
108=
109=v2.7
110=+ Improved display of device and key statuses
111=+ Excluded the title from sakura terminal  (bug: https://github.com/dabisu/sakura/issues/16)
112=+ Release for Mageia-9 and higher
