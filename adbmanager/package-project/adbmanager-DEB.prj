[NAME]
name=adbmanager

[VERSION]
version=4.1

[RELEASE]
release=0.mrx10

[GROUP]
group=Applications/System

[DESCRIPTION]
0=The program is designed for visual and easy management of the ADB and connection of Android devices
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=Manager for Android devices using ADB

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/adbmanager

[LICENSE]
license=GPLv3

[DEPS]
deps=adb iproute2 sakura nmap p7zip graphicsmagick xdg-utils libgtk2.0-0 libqt6core6 libqt6gui6 libqt6widgets6 libqt6network6 libqt6printsupport6 libqt6pas6

[META]
meta=0

[NOARCH]
noarch=0

[DEB]
deb=1

[FILES]
0=/usr/bin/adbmanager
1=/usr/share/icons/adbmanager.png
2=/usr/share/applications/adbmanager.desktop
3=/usr/share/adbmanager/
4=/usr/share/doc/adbmanager/
5=/usr/bin/adbmanager-qt
6=/usr/share/icons/adbmanager-qt.png
7=/usr/share/applications/adbmanager-qt.desktop

[AFTERINSTALL]
0=[ $(grep "adbusers" /etc/group) ] || groupadd adbusers

[URL32]
url32=https://github.com/AKotov-dev/adbmanager

[PROGRAMNAME]
programname=ADBManager

[DEVTOOL]
devtool=Lazarus

[TOOLVERSION]
toolversion=4.4

[INFO]
0=The program is designed for visual and easy management of the ADB and connection
1=of Android smartphones. Allows you to monitor the status of the "adb" service,
2=manage it, and control the list of connected devices.
3=
4=v4.1
5=+ Package installation / update: added the `-r` option
6=+ Android TV Box Settings: added a **Clear Download Manager data** button
7=+ Added packages for **Mageia-10**, **Fedora-44** and **Ubuntu ≥ 25.04**
8=
9=v4.0
10=+ Build in Lazarus-4.4
11=+ SDManager: Waiting process indicator
12=+ AppManager: Support for Android 4.2+
13=+ Moving app search and removal to AppManager
14=+ Mageia-9 and Ubuntu >= 25.04 packages
15=
16=v3.9
17=+ Improved inter-thread synchronization
18=+ Improved scaling/saving of form settings
19=+ Handling xdg-open errors on broken files
20=+ Android TV Box: CPU temperature indicator (°C)
21=+ Mageia-9 and Ubuntu >= 25.04 packages
22=
23=v3.8
24=+ Added `ADBManager-Qt` version (Qt6 widgets)
25=+ RPM dependencies: added `qtbase6-common`, `qt6pas`
26=+ DEB dependencies: added `libqt6core6`, `libqt6gui6`, `libqt6widgets6`, `libqt6network6`, `libqt6printsupport6`, `libqt6pas6`
27=+ Added a RAM device indicator: Total / Available (%)
28=+ Improved overall multithreading and responsiveness
29=+ Improved switching of devices in offline status (TCP/IP)
30=+ Improved the procedure for stopping package installations
31=+ Mageia-9 and Ubuntu >= 25.04 packages
32=
33=**Note:** Build for maintainers: `lazbuild --build-mode=Release adbmanager.lpi` and `lazbuild --build-mode=Qt6 adbmanager.lpi`. Build in Lazarus in two modes: `Release` and `Qt6`. For Mageia 9, a backport from Mageia 10 has been published here: lib64qt6pas6 and lib64qt6pas-devel.
34=
35=v3.7
36=+ Dependencies RPM/DEB: added `xdg-utils`
37=+ Dependencies RPM/DEB: replace `imagemagick` with `graphicsmagick`
38=+ Improved application list output stream
39=+ Improved SDCard manager for different DPI (text alignment)
40=+ Improved package search in the application manager (multiselect)
41=+ Double-clicking in the SDCard manager opens files using xdg-open
42=+ Mageia-9 and Debian packages
43=
44=v3.6
45=+ Icons in the app list if `IconExtractor.akp` is installed on the smartphone
46=+ Added RPM/DEB dependency: `imagemagick`
47=+ Mageia-9 and Debian packages
48=
49=**Note:** To display original icons in the application list, please install the [IconExtractor.apk](https://github.com/AKotov-dev/adbmanager/tree/main/IconExtractor) package on your smartphone. Installation of the package is optional.
50=
51=v3.5
52=+ Build in Lazarus-4.2
53=+ Devision by Zero bug fixed
54=+ Auto-scaling of SD card manager panels
55=+ Mageia-9 and Debian packages
56=
57=Recommended to delete the configuration directory: rm -rf ~/.adbmanager
58=
59=v3.4
60=+ Fine-tuning for Android TV Box
61=+ Mageia-9 and Debian packages + AppImage
62=
63=**Note:** Chinese Android TV Boxes often have stripped-down launchers installed, in which it is impossible to adjust the volume with the remote control, automatic updates and synchronization of Google accounts are not disabled, and there is even no control over system sounds (remote control clicks, etc.). In addition, excessive interface animation with a small amount of memory reduces the overall performance of the device. Now all this can be configured via ADB.
64=
65=v3.3
66=+ Added dependency `p7zip`
67=+ Cancel bulk package installation with `Esc`
68=+ Request to cancel package installation on exit
69=+ Improved procedure for canceling file copying
70=+ Multi installation of packages APK, APKS, XAPK
71=+ Mageia-9 and Debian packages + AppImage
72=
73=**Note:** Installation of `XAPK`packages with a single package architecture (32 bits or 64 bits) is supported. The presence of packages of both architectures (32 bits + 64 bits) in `XAPK` is not supported.
74=
75=v3.2
76=+ Recompiling to Lazarus-3.8
77=+ SD_Card Manager: Show Hidden Files
78=
79=**Note:** Be careful when working with hidden files. Do not delete or overwrite them unless necessary.
80=
81=v3.1
82=+ Exception of adb backup and restore; [Obsolete/Deprecated](https://issuetracker.google.com/issues/37096097)
83=+ Mageia-8/9 and Debian packages
84=
85=Note: Uninstalled apps are installed from Google Play [Barmalei » 17 feb 2023, 10:38](https://forum.rosalinux.ru/viewtopic.php?f=58&p=112751#p112751)
86=
87=v3.0
88=+ Deleting cache/data when uninstalling a system application
89=+ Mageia-8/9 and Debian packages
90=
91=v2.9
92=+ Removing non-removable applications (Android >= 6)
93=+ Mageia-8/9 and Debian packages
94=
95=v2.8
96=+ Enabling/Disabling applications
97=+ Mageia-8/9 and Debian packages
98=+ Recompilation in Lazarus 2.2.4
99=
100=v2.7
101=+ Improved display of device and key statuses
102=+ Excluded the title from sakura terminal  (bug: https://github.com/dabisu/sakura/issues/16)
103=+ Release for Mageia-9 and higher
