[NAME]
name=adbmanager

[VERSION]
version=4.0

[RELEASE]
release=0.mrx10

[GROUP]
group=Applications/System

[DESCRIPTION]
0=The program is designed for visual and easy management of the ADB and connection of Android devices
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2025

[SUMMARY]
summary=Manager for Android devices using ADB

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/adbmanager

[LICENSE]
license=GPLv3

[DEPS]
deps=adb iproute2 sakura nmap p7zip 7zip graphicsmagick xdg-utils qtbase6-common qt6pas gtk2

[META]
meta=0

[NOARCH]
noarch=0

[DEB]
deb=0

[FILES]
0=/usr/bin/adbmanager
1=/usr/share/icons/adbmanager.png
2=/usr/share/applications/adbmanager.desktop
3=/usr/share/adbmanager/
4=/usr/share/doc/adbmanager/
5=/usr/bin/adbmanager-qt
6=/usr/share/icons/adbmanager-qt.png
7=/usr/share/applications/adbmanager-qt.desktop

[AFTERINSTALL]
0=[ $(grep "adbusers" /etc/group) ] || groupadd adbusers

[URL32]
url32=https://github.com/AKotov-dev/adbmanager

[PROGRAMNAME]
programname=ADBManager

[DEVTOOL]
devtool=Lazarus

[TOOLVERSION]
toolversion=4.4

[INFO]
0=The program is designed for visual and easy management of the ADB and connection
1=of Android smartphones. Allows you to monitor the status of the "adb" service,
2=manage it, and control the list of connected devices.
3=
4=v4.0
5=+ Build in Lazarus-4.4
6=+ SDManager: Waiting process indicator
7=+ AppManager: Support for Android 4.2+
8=+ Moving app search and removal to AppManager
9=+ Mageia-9 and Ubuntu >= 25.04 packages
10=+ Added RPM packages for Mageia-10 (UPD: 210426)
11=
12=v3.9
13=+ Improved inter-thread synchronization
14=+ Improved scaling/saving of form settings
15=+ Handling xdg-open errors on broken files
16=+ Android TV Box: CPU temperature indicator (°C)
17=+ Mageia-9 and Ubuntu >= 25.04 packages
18=
19=v3.8
20=+ Added `ADBManager-Qt` version (Qt6 widgets)
21=+ RPM dependencies: added `qtbase6-common`, `qt6pas`
22=+ DEB dependencies: added `libqt6core6`, `libqt6gui6`, `libqt6widgets6`, `libqt6network6`, `libqt6printsupport6`, `libqt6pas6`
23=+ Added a RAM device indicator: Total / Available (%)
24=+ Improved overall multithreading and responsiveness
25=+ Improved switching of devices in offline status (TCP/IP)
26=+ Improved the procedure for stopping package installations
27=+ Mageia-9 and Ubuntu >= 25.04 packages
28=
29=**Note:** Build for maintainers: `lazbuild --build-mode=Release adbmanager.lpi` and `lazbuild --build-mode=Qt6 adbmanager.lpi`. Build in Lazarus in two modes: `Release` and `Qt6`. For Mageia 9, a backport from Mageia 10 has been published here: lib64qt6pas6 and lib64qt6pas-devel.
30=
31=v3.7
32=+ Dependencies RPM/DEB: added `xdg-utils`
33=+ Dependencies RPM/DEB: replace `imagemagick` with `graphicsmagick`
34=+ Improved application list output stream
35=+ Improved SDCard manager for different DPI (text alignment)
36=+ Improved package search in the application manager (multiselect)
37=+ Double-clicking in the SDCard manager opens files using xdg-open
38=+ Mageia-9 and Debian packages
39=
40=v3.6
41=+ Icons in the app list if `IconExtractor.akp` is installed on the smartphone
42=+ Added RPM/DEB dependency: `imagemagick`
43=+ Mageia-9 and Debian packages
44=
45=**Note:** To display original icons in the application list, please install the [IconExtractor.apk](https://github.com/AKotov-dev/adbmanager/tree/main/IconExtractor) package on your smartphone. Installation of the package is optional.
46=
47=v3.5
48=+ Build in Lazarus-4.2
49=+ Devision by Zero bug fixed
50=+ Auto-scaling of SD card manager panels
51=+ Mageia-9 and Debian packages
52=
53=Recommended to delete the configuration directory: rm -rf ~/.adbmanager
54=
55=v3.4
56=+ Fine-tuning for Android TV Box
57=+ Mageia-9 and Debian packages + AppImage
58=
59=**Note:** Chinese Android TV Boxes often have stripped-down launchers installed, in which it is impossible to adjust the volume with the remote control, automatic updates and synchronization of Google accounts are not disabled, and there is even no control over system sounds (remote control clicks, etc.). In addition, excessive interface animation with a small amount of memory reduces the overall performance of the device. Now all this can be configured via ADB.
60=
61=v3.3
62=+ Added dependency `p7zip`
63=+ Cancel bulk package installation with `Esc`
64=+ Request to cancel package installation on exit
65=+ Improved procedure for canceling file copying
66=+ Multi installation of packages APK, APKS, XAPK
67=+ Mageia-9 and Debian packages + AppImage
68=
69=**Note:** Installation of `XAPK`packages with a single package architecture (32 bits or 64 bits) is supported. The presence of packages of both architectures (32 bits + 64 bits) in `XAPK` is not supported.
70=
71=v3.2
72=+ Recompiling to Lazarus-3.8
73=+ SD_Card Manager: Show Hidden Files
74=
75=**Note:** Be careful when working with hidden files. Do not delete or overwrite them unless necessary.
76=
77=v3.1
78=+ Exception of adb backup and restore; [Obsolete/Deprecated](https://issuetracker.google.com/issues/37096097)
79=+ Mageia-8/9 and Debian packages
80=
81=Note: Uninstalled apps are installed from Google Play [Barmalei » 17 feb 2023, 10:38](https://forum.rosalinux.ru/viewtopic.php?f=58&p=112751#p112751)
82=
83=v3.0
84=+ Deleting cache/data when uninstalling a system application
85=+ Mageia-8/9 and Debian packages
86=
87=v2.9
88=+ Removing non-removable applications (Android >= 6)
89=+ Mageia-8/9 and Debian packages
90=
91=v2.8
92=+ Enabling/Disabling applications
93=+ Mageia-8/9 and Debian packages
94=+ Recompilation in Lazarus 2.2.4
95=
96=v2.7
97=+ Improved display of device and key statuses
98=+ Excluded the title from sakura terminal  (bug: https://github.com/dabisu/sakura/issues/16)
99=+ Release for Mageia-9 and higher
