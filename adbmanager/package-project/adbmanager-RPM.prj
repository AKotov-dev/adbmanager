[NAME]
name=adbmanager

[VERSION]
version=3.9

[RELEASE]
release=0.mrx9

[GROUP]
group=Applications/System

[DESCRIPTION]
0=The program is designed for visual and easy management of the ADB and connection of Android devices
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2025

[SUMMARY]
summary=Manager for Android devices using ADB

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/adbmanager

[LICENSE]
license=GPLv3

[DEPS]
deps=adb iproute2 sakura nmap p7zip graphicsmagick xdg-utils qtbase6-common qt6pas gtk2

[META]
meta=0

[NOARCH]
noarch=0

[DEB]
deb=0

[FILES]
0=/usr/bin/adbmanager
1=/usr/share/icons/adbmanager.png
2=/usr/share/applications/adbmanager.desktop
3=/usr/share/adbmanager/
4=/usr/share/doc/adbmanager/
5=/usr/bin/adbmanager-qt
6=/usr/share/icons/adbmanager-qt.png
7=/usr/share/applications/adbmanager-qt.desktop

[AFTERINSTALL]
0=[ $(grep "adbusers" /etc/group) ] || groupadd adbusers

[URL32]
url32=https://github.com/AKotov-dev/adbmanager

[PROGRAMNAME]
programname=ADBManager

[DEVTOOL]
devtool=Lazarus

[TOOLVERSION]
toolversion=4.2

[INFO]
0=The program is designed for visual and easy management of the ADB and connection
1=of Android smartphones. Allows you to monitor the status of the "adb" service,
2=manage it, and control the list of connected devices.
3=
4=v4.0
5=+ SDManager: Waiting process indicator
6=+ AppManager: Support for Android 4.2+
7=+ Moving app search and removal to AppManager
8=+ Mageia-9 and Ubuntu >= 25.04 packages
9=
10=v3.9
11=+ Improved inter-thread synchronization
12=+ Improved scaling/saving of form settings
13=+ Handling xdg-open errors on broken files
14=+ Android TV Box: CPU temperature indicator (°C)
15=+ Mageia-9 and Ubuntu >= 25.04 packages
16=
17=v3.8
18=+ Added `ADBManager-Qt` version (Qt6 widgets)
19=+ RPM dependencies: added `qtbase6-common`, `qt6pas`
20=+ DEB dependencies: added `libqt6core6`, `libqt6gui6`, `libqt6widgets6`, `libqt6network6`, `libqt6printsupport6`, `libqt6pas6`
21=+ Added a RAM device indicator: Total / Available (%)
22=+ Improved overall multithreading and responsiveness
23=+ Improved switching of devices in offline status (TCP/IP)
24=+ Improved the procedure for stopping package installations
25=+ Mageia-9 and Ubuntu >= 25.04 packages
26=
27=**Note:** Build for maintainers: `lazbuild --build-mode=Release adbmanager.lpi` and `lazbuild --build-mode=Qt6 adbmanager.lpi`. Build in Lazarus in two modes: `Release` and `Qt6`. For Mageia 9, a backport from Mageia 10 has been published here: lib64qt6pas6 and lib64qt6pas-devel.
28=
29=v3.7
30=+ Dependencies RPM/DEB: added `xdg-utils`
31=+ Dependencies RPM/DEB: replace `imagemagick` with `graphicsmagick`
32=+ Improved application list output stream
33=+ Improved SDCard manager for different DPI (text alignment)
34=+ Improved package search in the application manager (multiselect)
35=+ Double-clicking in the SDCard manager opens files using xdg-open
36=+ Mageia-9 and Debian packages
37=
38=v3.6
39=+ Icons in the app list if `IconExtractor.akp` is installed on the smartphone
40=+ Added RPM/DEB dependency: `imagemagick`
41=+ Mageia-9 and Debian packages
42=
43=**Note:** To display original icons in the application list, please install the [IconExtractor.apk](https://github.com/AKotov-dev/adbmanager/tree/main/IconExtractor) package on your smartphone. Installation of the package is optional.
44=
45=v3.5
46=+ Build in Lazarus-4.2
47=+ Devision by Zero bug fixed
48=+ Auto-scaling of SD card manager panels
49=+ Mageia-9 and Debian packages
50=
51=Recommended to delete the configuration directory: rm -rf ~/.adbmanager
52=
53=v3.4
54=+ Fine-tuning for Android TV Box
55=+ Mageia-9 and Debian packages + AppImage
56=
57=**Note:** Chinese Android TV Boxes often have stripped-down launchers installed, in which it is impossible to adjust the volume with the remote control, automatic updates and synchronization of Google accounts are not disabled, and there is even no control over system sounds (remote control clicks, etc.). In addition, excessive interface animation with a small amount of memory reduces the overall performance of the device. Now all this can be configured via ADB.
58=
59=v3.3
60=+ Added dependency `p7zip`
61=+ Cancel bulk package installation with `Esc`
62=+ Request to cancel package installation on exit
63=+ Improved procedure for canceling file copying
64=+ Multi installation of packages APK, APKS, XAPK
65=+ Mageia-9 and Debian packages + AppImage
66=
67=**Note:** Installation of `XAPK`packages with a single package architecture (32 bits or 64 bits) is supported. The presence of packages of both architectures (32 bits + 64 bits) in `XAPK` is not supported.
68=
69=v3.2
70=+ Recompiling to Lazarus-3.8
71=+ SD_Card Manager: Show Hidden Files
72=
73=**Note:** Be careful when working with hidden files. Do not delete or overwrite them unless necessary.
74=
75=v3.1
76=+ Exception of adb backup and restore; [Obsolete/Deprecated](https://issuetracker.google.com/issues/37096097)
77=+ Mageia-8/9 and Debian packages
78=
79=Note: Uninstalled apps are installed from Google Play [Barmalei » 17 feb 2023, 10:38](https://forum.rosalinux.ru/viewtopic.php?f=58&p=112751#p112751)
80=
81=v3.0
82=+ Deleting cache/data when uninstalling a system application
83=+ Mageia-8/9 and Debian packages
84=
85=v2.9
86=+ Removing non-removable applications (Android >= 6)
87=+ Mageia-8/9 and Debian packages
88=
89=v2.8
90=+ Enabling/Disabling applications
91=+ Mageia-8/9 and Debian packages
92=+ Recompilation in Lazarus 2.2.4
93=
94=v2.7
95=+ Improved display of device and key statuses
96=+ Excluded the title from sakura terminal  (bug: https://github.com/dabisu/sakura/issues/16)
97=+ Release for Mageia-9 and higher
