[NAME]
name=adbmanager

[VERSION]
version=4.1

[RELEASE]
release=0.fc44

[GROUP]
group=Applications/System

[DESCRIPTION]
0=The program is designed for visual and easy management of the ADB and connection of Android devices
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=Manager for Android devices using ADB

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/adbmanager

[LICENSE]
license=GPLv3

[DEPS]
deps=adb iproute nmap p7zip 7zip GraphicsMagick xdg-utils qt6-qtbase-common qt6pas gtk2

[META]
meta=0

[NOARCH]
noarch=0

[DEB]
deb=0

[FILES]
0=/usr/bin/adbmanager
1=/usr/share/icons/adbmanager.png
2=/usr/share/applications/adbmanager.desktop
3=/usr/share/adbmanager/
4=/usr/share/doc/adbmanager/
5=/usr/bin/adbmanager-qt
6=/usr/share/icons/adbmanager-qt.png
7=/usr/share/applications/adbmanager-qt.desktop
8=/usr/bin/adbmanager-shell
9=/usr/share/applications/adbmanager-shell.desktop

[AFTERINSTALL]
0=[ $(grep "adbusers" /etc/group) ] || groupadd adbusers

[URL32]
url32=https://github.com/AKotov-dev/adbmanager

[PROGRAMNAME]
programname=ADBManager

[DEVTOOL]
devtool=Lazarus

[TOOLVERSION]
toolversion=4.4

[INFO]
0=The program is designed for visual and easy management of the ADB and connection
1=of Android smartphones. Allows you to monitor the status of the "adb" service,
2=manage it, and control the list of connected devices.
3=
4=v4.1
5=+ Package installation / update: added the `-r` option
6=+ Replaced Sakura with the system default terminal emulator
7=+ Android TV Box Settings: added a **Clear Download Manager data** button
8=+ Added packages for **Mageia 10**, **Fedora 44** and **Ubuntu ≥ 25.04**
9=
10=**Note:** The **Clear Download Manager data** button deletes data and incomplete downloads from the system Download Manager. It can free up space occupied by failed or stalled downloads.
11=
12=v4.0
13=+ Build in Lazarus-4.4
14=+ SDManager: Waiting process indicator
15=+ AppManager: Support for Android 4.2+
16=+ Moving app search and removal to AppManager
17=+ Mageia-9 and Ubuntu >= 25.04 packages
18=+ Added RPM packages for Mageia-10 (UPD: 210426)
19=
20=v3.9
21=+ Improved inter-thread synchronization
22=+ Improved scaling/saving of form settings
23=+ Handling xdg-open errors on broken files
24=+ Android TV Box: CPU temperature indicator (°C)
25=+ Mageia-9 and Ubuntu >= 25.04 packages
26=
27=v3.8
28=+ Added `ADBManager-Qt` version (Qt6 widgets)
29=+ RPM dependencies: added `qtbase6-common`, `qt6pas`
30=+ DEB dependencies: added `libqt6core6`, `libqt6gui6`, `libqt6widgets6`, `libqt6network6`, `libqt6printsupport6`, `libqt6pas6`
31=+ Added a RAM device indicator: Total / Available (%)
32=+ Improved overall multithreading and responsiveness
33=+ Improved switching of devices in offline status (TCP/IP)
34=+ Improved the procedure for stopping package installations
35=+ Mageia-9 and Ubuntu >= 25.04 packages
36=
37=**Note:** Build for maintainers: `lazbuild --build-mode=Release adbmanager.lpi` and `lazbuild --build-mode=Qt6 adbmanager.lpi`. Build in Lazarus in two modes: `Release` and `Qt6`. For Mageia 9, a backport from Mageia 10 has been published here: lib64qt6pas6 and lib64qt6pas-devel.
38=
39=v3.7
40=+ Dependencies RPM/DEB: added `xdg-utils`
41=+ Dependencies RPM/DEB: replace `imagemagick` with `graphicsmagick`
42=+ Improved application list output stream
43=+ Improved SDCard manager for different DPI (text alignment)
44=+ Improved package search in the application manager (multiselect)
45=+ Double-clicking in the SDCard manager opens files using xdg-open
46=+ Mageia-9 and Debian packages
47=
48=v3.6
49=+ Icons in the app list if `IconExtractor.akp` is installed on the smartphone
50=+ Added RPM/DEB dependency: `imagemagick`
51=+ Mageia-9 and Debian packages
52=
53=**Note:** To display original icons in the application list, please install the [IconExtractor.apk](https://github.com/AKotov-dev/adbmanager/tree/main/IconExtractor) package on your smartphone. Installation of the package is optional.
54=
55=v3.5
56=+ Build in Lazarus-4.2
57=+ Devision by Zero bug fixed
58=+ Auto-scaling of SD card manager panels
59=+ Mageia-9 and Debian packages
60=
61=Recommended to delete the configuration directory: rm -rf ~/.adbmanager
62=
63=v3.4
64=+ Fine-tuning for Android TV Box
65=+ Mageia-9 and Debian packages + AppImage
66=
67=**Note:** Chinese Android TV Boxes often have stripped-down launchers installed, in which it is impossible to adjust the volume with the remote control, automatic updates and synchronization of Google accounts are not disabled, and there is even no control over system sounds (remote control clicks, etc.). In addition, excessive interface animation with a small amount of memory reduces the overall performance of the device. Now all this can be configured via ADB.
68=
69=v3.3
70=+ Added dependency `p7zip`
71=+ Cancel bulk package installation with `Esc`
72=+ Request to cancel package installation on exit
73=+ Improved procedure for canceling file copying
74=+ Multi installation of packages APK, APKS, XAPK
75=+ Mageia-9 and Debian packages + AppImage
76=
77=**Note:** Installation of `XAPK`packages with a single package architecture (32 bits or 64 bits) is supported. The presence of packages of both architectures (32 bits + 64 bits) in `XAPK` is not supported.
78=
79=v3.2
80=+ Recompiling to Lazarus-3.8
81=+ SD_Card Manager: Show Hidden Files
82=
83=**Note:** Be careful when working with hidden files. Do not delete or overwrite them unless necessary.
84=
85=v3.1
86=+ Exception of adb backup and restore; [Obsolete/Deprecated](https://issuetracker.google.com/issues/37096097)
87=+ Mageia-8/9 and Debian packages
88=
89=Note: Uninstalled apps are installed from Google Play [Barmalei » 17 feb 2023, 10:38](https://forum.rosalinux.ru/viewtopic.php?f=58&p=112751#p112751)
90=
91=v3.0
92=+ Deleting cache/data when uninstalling a system application
93=+ Mageia-8/9 and Debian packages
94=
95=v2.9
96=+ Removing non-removable applications (Android >= 6)
97=+ Mageia-8/9 and Debian packages
98=
99=v2.8
100=+ Enabling/Disabling applications
101=+ Mageia-8/9 and Debian packages
102=+ Recompilation in Lazarus 2.2.4
103=
104=v2.7
105=+ Improved display of device and key statuses
106=+ Excluded the title from sakura terminal  (bug: https://github.com/dabisu/sakura/issues/16)
107=+ Release for Mageia-9 and higher
