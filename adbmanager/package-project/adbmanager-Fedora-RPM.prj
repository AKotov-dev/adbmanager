[NAME]
name=adbmanager

[VERSION]
version=4.1

[RELEASE]
release=0.fc44

[GROUP]
group=Applications/System

[DESCRIPTION]
0=The program is designed for visual and easy management of the ADB and connection of Android devices
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=Manager for Android devices using ADB

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/adbmanager

[LICENSE]
license=GPLv3

[DEPS]
deps=adb iproute nmap 7zip GraphicsMagick xdg-utils qt6-qtbase qt6pas gtk2

[META]
meta=0

[NOARCH]
noarch=0

[DEB]
deb=0

[FILES]
0=/usr/bin/adbmanager
1=/usr/share/icons/adbmanager.png
2=/usr/share/applications/adbmanager.desktop
3=/usr/share/adbmanager/
4=/usr/share/doc/adbmanager/
5=/usr/bin/adbmanager-qt
6=/usr/share/icons/adbmanager-qt.png
7=/usr/share/applications/adbmanager-qt.desktop
8=/usr/bin/adbmanager-shell
9=/usr/share/applications/adbmanager-shell.desktop

[AFTERINSTALL]
0=[ $(grep "adbusers" /etc/group) ] || groupadd adbusers

[URL32]
url32=https://github.com/AKotov-dev/adbmanager

[PROGRAMNAME]
programname=ADBManager

[DEVTOOL]
devtool=Lazarus

[TOOLVERSION]
toolversion=4.4

[INFO]
0=The program is designed for visual and easy management of the ADB and connection
1=of Android smartphones. Allows you to monitor the status of the "adb" service,
2=manage it, and control the list of connected devices.
3=
4=v4.1
5=+ Package installation / update: added the `-r` option
6=+ Replaced Sakura with the system default terminal emulator
7=+ Android TV Box Settings: added a **Clear Download Manager data** button
8=+ Added packages for **Mageia 10**, **Fedora 44** and **Ubuntu ≥ 25.04**
9=
10=**Maintainer note**
11=Sakura is no longer required; ADB Manager uses the system default terminal.
12=The helper script and desktop entry are installed as:
13=```
14=/usr/bin/adbmanager-shell
15=/usr/share/applications/adbmanager-shell.desktop
16=```
17=
18=v4.0
19=+ Build in Lazarus-4.4
20=+ SDManager: Waiting process indicator
21=+ AppManager: Support for Android 4.2+
22=+ Moving app search and removal to AppManager
23=+ Mageia-9 and Ubuntu >= 25.04 packages
24=+ Added RPM packages for Mageia-10 (UPD: 210426)
25=
26=v3.9
27=+ Improved inter-thread synchronization
28=+ Improved scaling/saving of form settings
29=+ Handling xdg-open errors on broken files
30=+ Android TV Box: CPU temperature indicator (°C)
31=+ Mageia-9 and Ubuntu >= 25.04 packages
32=
33=v3.8
34=+ Added `ADBManager-Qt` version (Qt6 widgets)
35=+ RPM dependencies: added `qtbase6-common`, `qt6pas`
36=+ DEB dependencies: added `libqt6core6`, `libqt6gui6`, `libqt6widgets6`, `libqt6network6`, `libqt6printsupport6`, `libqt6pas6`
37=+ Added a RAM device indicator: Total / Available (%)
38=+ Improved overall multithreading and responsiveness
39=+ Improved switching of devices in offline status (TCP/IP)
40=+ Improved the procedure for stopping package installations
41=+ Mageia-9 and Ubuntu >= 25.04 packages
42=
43=**Note:** Build for maintainers: `lazbuild --build-mode=Release adbmanager.lpi` and `lazbuild --build-mode=Qt6 adbmanager.lpi`. Build in Lazarus in two modes: `Release` and `Qt6`. For Mageia 9, a backport from Mageia 10 has been published here: lib64qt6pas6 and lib64qt6pas-devel.
44=
45=v3.7
46=+ Dependencies RPM/DEB: added `xdg-utils`
47=+ Dependencies RPM/DEB: replace `imagemagick` with `graphicsmagick`
48=+ Improved application list output stream
49=+ Improved SDCard manager for different DPI (text alignment)
50=+ Improved package search in the application manager (multiselect)
51=+ Double-clicking in the SDCard manager opens files using xdg-open
52=+ Mageia-9 and Debian packages
53=
54=v3.6
55=+ Icons in the app list if `IconExtractor.akp` is installed on the smartphone
56=+ Added RPM/DEB dependency: `imagemagick`
57=+ Mageia-9 and Debian packages
58=
59=**Note:** To display original icons in the application list, please install the [IconExtractor.apk](https://github.com/AKotov-dev/adbmanager/tree/main/IconExtractor) package on your smartphone. Installation of the package is optional.
60=
61=v3.5
62=+ Build in Lazarus-4.2
63=+ Devision by Zero bug fixed
64=+ Auto-scaling of SD card manager panels
65=+ Mageia-9 and Debian packages
66=
67=Recommended to delete the configuration directory: rm -rf ~/.adbmanager
68=
69=v3.4
70=+ Fine-tuning for Android TV Box
71=+ Mageia-9 and Debian packages + AppImage
72=
73=**Note:** Chinese Android TV Boxes often have stripped-down launchers installed, in which it is impossible to adjust the volume with the remote control, automatic updates and synchronization of Google accounts are not disabled, and there is even no control over system sounds (remote control clicks, etc.). In addition, excessive interface animation with a small amount of memory reduces the overall performance of the device. Now all this can be configured via ADB.
74=
75=v3.3
76=+ Added dependency `p7zip`
77=+ Cancel bulk package installation with `Esc`
78=+ Request to cancel package installation on exit
79=+ Improved procedure for canceling file copying
80=+ Multi installation of packages APK, APKS, XAPK
81=+ Mageia-9 and Debian packages + AppImage
82=
83=**Note:** Installation of `XAPK`packages with a single package architecture (32 bits or 64 bits) is supported. The presence of packages of both architectures (32 bits + 64 bits) in `XAPK` is not supported.
84=
85=v3.2
86=+ Recompiling to Lazarus-3.8
87=+ SD_Card Manager: Show Hidden Files
88=
89=**Note:** Be careful when working with hidden files. Do not delete or overwrite them unless necessary.
90=
91=v3.1
92=+ Exception of adb backup and restore; [Obsolete/Deprecated](https://issuetracker.google.com/issues/37096097)
93=+ Mageia-8/9 and Debian packages
94=
95=Note: Uninstalled apps are installed from Google Play [Barmalei » 17 feb 2023, 10:38](https://forum.rosalinux.ru/viewtopic.php?f=58&p=112751#p112751)
96=
97=v3.0
98=+ Deleting cache/data when uninstalling a system application
99=+ Mageia-8/9 and Debian packages
100=
101=v2.9
102=+ Removing non-removable applications (Android >= 6)
103=+ Mageia-8/9 and Debian packages
104=
105=v2.8
106=+ Enabling/Disabling applications
107=+ Mageia-8/9 and Debian packages
108=+ Recompilation in Lazarus 2.2.4
109=
110=v2.7
111=+ Improved display of device and key statuses
112=+ Excluded the title from sakura terminal  (bug: https://github.com/dabisu/sakura/issues/16)
113=+ Release for Mageia-9 and higher
