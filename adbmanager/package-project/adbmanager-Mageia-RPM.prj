[NAME]
name=adbmanager

[VERSION]
version=4.1

[RELEASE]
release=0.mrx10

[GROUP]
group=Applications/System

[DESCRIPTION]
0=The program is designed for visual and easy management of the ADB and connection of Android devices
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=Manager for Android devices using ADB

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/adbmanager

[LICENSE]
license=GPLv3

[DEPS]
deps=adb iproute2 sakura nmap p7zip 7zip graphicsmagick xdg-utils qtbase6-common qt6pas gtk2

[META]
meta=0

[NOARCH]
noarch=0

[DEB]
deb=0

[FILES]
0=/usr/bin/adbmanager
1=/usr/share/icons/adbmanager.png
2=/usr/share/applications/adbmanager.desktop
3=/usr/share/adbmanager/
4=/usr/share/doc/adbmanager/
5=/usr/bin/adbmanager-qt
6=/usr/share/icons/adbmanager-qt.png
7=/usr/share/applications/adbmanager-qt.desktop

[AFTERINSTALL]
0=[ $(grep "adbusers" /etc/group) ] || groupadd adbusers

[URL32]
url32=https://github.com/AKotov-dev/adbmanager

[PROGRAMNAME]
programname=ADBManager

[DEVTOOL]
devtool=Lazarus

[TOOLVERSION]
toolversion=4.4

[INFO]
0=The program is designed for visual and easy management of the ADB and connection
1=of Android smartphones. Allows you to monitor the status of the "adb" service,
2=manage it, and control the list of connected devices.
3=
4=v4.1
5=+ Package installation / update: added the `-r` option
6=+ Android TV Box Settings: added a **Clear Download Manager data** button
7=+ Added packages for **Mageia 10**, **Fedora 44** and **Ubuntu ≥ 25.04**
8=
9=**Note:** The **Clear Download Manager data** button deletes data and incomplete downloads from the system Download Manager. It can free up space occupied by failed or stalled downloads.
10=
11=v4.0
12=+ Build in Lazarus-4.4
13=+ SDManager: Waiting process indicator
14=+ AppManager: Support for Android 4.2+
15=+ Moving app search and removal to AppManager
16=+ Mageia-9 and Ubuntu >= 25.04 packages
17=+ Added RPM packages for Mageia-10 (UPD: 210426)
18=
19=v3.9
20=+ Improved inter-thread synchronization
21=+ Improved scaling/saving of form settings
22=+ Handling xdg-open errors on broken files
23=+ Android TV Box: CPU temperature indicator (°C)
24=+ Mageia-9 and Ubuntu >= 25.04 packages
25=
26=v3.8
27=+ Added `ADBManager-Qt` version (Qt6 widgets)
28=+ RPM dependencies: added `qtbase6-common`, `qt6pas`
29=+ DEB dependencies: added `libqt6core6`, `libqt6gui6`, `libqt6widgets6`, `libqt6network6`, `libqt6printsupport6`, `libqt6pas6`
30=+ Added a RAM device indicator: Total / Available (%)
31=+ Improved overall multithreading and responsiveness
32=+ Improved switching of devices in offline status (TCP/IP)
33=+ Improved the procedure for stopping package installations
34=+ Mageia-9 and Ubuntu >= 25.04 packages
35=
36=**Note:** Build for maintainers: `lazbuild --build-mode=Release adbmanager.lpi` and `lazbuild --build-mode=Qt6 adbmanager.lpi`. Build in Lazarus in two modes: `Release` and `Qt6`. For Mageia 9, a backport from Mageia 10 has been published here: lib64qt6pas6 and lib64qt6pas-devel.
37=
38=v3.7
39=+ Dependencies RPM/DEB: added `xdg-utils`
40=+ Dependencies RPM/DEB: replace `imagemagick` with `graphicsmagick`
41=+ Improved application list output stream
42=+ Improved SDCard manager for different DPI (text alignment)
43=+ Improved package search in the application manager (multiselect)
44=+ Double-clicking in the SDCard manager opens files using xdg-open
45=+ Mageia-9 and Debian packages
46=
47=v3.6
48=+ Icons in the app list if `IconExtractor.akp` is installed on the smartphone
49=+ Added RPM/DEB dependency: `imagemagick`
50=+ Mageia-9 and Debian packages
51=
52=**Note:** To display original icons in the application list, please install the [IconExtractor.apk](https://github.com/AKotov-dev/adbmanager/tree/main/IconExtractor) package on your smartphone. Installation of the package is optional.
53=
54=v3.5
55=+ Build in Lazarus-4.2
56=+ Devision by Zero bug fixed
57=+ Auto-scaling of SD card manager panels
58=+ Mageia-9 and Debian packages
59=
60=Recommended to delete the configuration directory: rm -rf ~/.adbmanager
61=
62=v3.4
63=+ Fine-tuning for Android TV Box
64=+ Mageia-9 and Debian packages + AppImage
65=
66=**Note:** Chinese Android TV Boxes often have stripped-down launchers installed, in which it is impossible to adjust the volume with the remote control, automatic updates and synchronization of Google accounts are not disabled, and there is even no control over system sounds (remote control clicks, etc.). In addition, excessive interface animation with a small amount of memory reduces the overall performance of the device. Now all this can be configured via ADB.
67=
68=v3.3
69=+ Added dependency `p7zip`
70=+ Cancel bulk package installation with `Esc`
71=+ Request to cancel package installation on exit
72=+ Improved procedure for canceling file copying
73=+ Multi installation of packages APK, APKS, XAPK
74=+ Mageia-9 and Debian packages + AppImage
75=
76=**Note:** Installation of `XAPK`packages with a single package architecture (32 bits or 64 bits) is supported. The presence of packages of both architectures (32 bits + 64 bits) in `XAPK` is not supported.
77=
78=v3.2
79=+ Recompiling to Lazarus-3.8
80=+ SD_Card Manager: Show Hidden Files
81=
82=**Note:** Be careful when working with hidden files. Do not delete or overwrite them unless necessary.
83=
84=v3.1
85=+ Exception of adb backup and restore; [Obsolete/Deprecated](https://issuetracker.google.com/issues/37096097)
86=+ Mageia-8/9 and Debian packages
87=
88=Note: Uninstalled apps are installed from Google Play [Barmalei » 17 feb 2023, 10:38](https://forum.rosalinux.ru/viewtopic.php?f=58&p=112751#p112751)
89=
90=v3.0
91=+ Deleting cache/data when uninstalling a system application
92=+ Mageia-8/9 and Debian packages
93=
94=v2.9
95=+ Removing non-removable applications (Android >= 6)
96=+ Mageia-8/9 and Debian packages
97=
98=v2.8
99=+ Enabling/Disabling applications
100=+ Mageia-8/9 and Debian packages
101=+ Recompilation in Lazarus 2.2.4
102=
103=v2.7
104=+ Improved display of device and key statuses
105=+ Excluded the title from sakura terminal  (bug: https://github.com/dabisu/sakura/issues/16)
106=+ Release for Mageia-9 and higher
